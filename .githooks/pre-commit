#!/usr/bin/env bash
# installed by scripts/setup-hooks.sh — edit .githooks/, then re-run it
# Pre-commit hook: lint and test checks
set -e

# Cheap and first: catches a partial flutter_rust_bridge version bump before it lands.
echo "▶ flutter_rust_bridge pin check..."
./scripts/frb-generate.sh --check

echo "▶ cargo test..."
(cd rust && cargo test 2>&1)

echo "▶ cargo clippy..."
(cd rust && cargo clippy -- -D warnings 2>&1)

echo "▶ cargo check (wasm32)..."
(cd rust && cargo check --target wasm32-unknown-unknown 2>&1)

echo "▶ flutter analyze..."
# Git exports GIT_DIR/GIT_INDEX_FILE to hooks; the flutter tool inherits them and reads its
# own SDK version from this repo instead ("0.0.0-unknown"), so pub resolution fails.
env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE flutter analyze 2>&1

echo "✓ All checks passed"
